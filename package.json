{
  "name": "espark-talent-revamp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npx prettier --check '**/*.{js,jsx}' --ignore-path .gitignore",
    "format:fix": "npx prettier --write '**/*.{js,jsx}' --ignore-path .gitignore",
    "prepare": "husky install"
  },

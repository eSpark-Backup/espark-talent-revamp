{
  "name": "espark-talent-revamp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npx prettier --check '**/*.{js,jsx}' --ignore-path .gitignore",
    "format:fix": "npx prettier --write '**/*.{js,jsx}' --ignore-path .gitignore",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": "eslint --cache --fix"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.2",
    "@mui/material": "^5.15.2",
    "@mui/material-nextjs": "^5.15.0",
    "@mui/system": "^5.15.2",
    "@reduxjs/toolkit": "^1.9.7",
    "core-js": "^3.35.0",
    "dotenv": "^16.3.1",
    "formik": "^2.4.5",
    "next": "^14.0",
    "react": "^18",
    "react-awesome-reveal": "^4.2.7",
    "react-dom": "^18",
    "react-modern-drawer": "^1.2.2",
    "react-phone-number-input": "^3.3.8",
    "react-redux": "^8.1.3",
    "react-responsive": "^9.0.2",
    "react-router-dom": "^6.17.0",
    "react-slick": "^0.29.0",
    "redux": "^4.2.1",
    "slick-carousel": "^1.8.1",
    "swiper": "^10.3.1",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.2",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.6",
    "tailwindcss": "^3.3.3"
  }
}

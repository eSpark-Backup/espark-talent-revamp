    "@mui/material": "^5.15.2",
    "@mui/material-nextjs": "^5.15.0",
    "@next/third-parties": "^15.4.1",
    "@portabletext/react": "^3.0.11",
    "@sanity/client": "^6.11.1",
    "@sanity/image-url": "^1.0.2",
    "@sendgrid/mail": "^8.1.0",
    "@supabase/supabase-js": "^1.35.6",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.7",
    "cors": "^2.8.5",

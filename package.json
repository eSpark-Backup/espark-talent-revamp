    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^5.15.2",
    "@mui/material-nextjs": "^9.1.0",
    "@next/third-parties": "^16.2.7",
    "@portabletext/react": "^3.0.11",
    "@sanity/client": "^6.11.1",
    "@sanity/image-url": "^2.1.1",
    "@sendgrid/mail": "^8.1.0",
    "@supabase/supabase-js": "^2.108.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.17.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "formik": "^2.4.5",

    "next": "16.2.7",
    "react": "19.2.7",
    "npm": "^11.16.0",
    "postcss": "^8.5.10",
    "react-dom": "19.3.0",
    "react-calendly": "^4.3.0",
    "react-loading-skeleton": "^3.4.0",
    "react-number-format": "^5.3.4",
    "react-phone-input-2": "^2.15.1",
    "react-phone-number-input": "^3.3.8",
    "react-select": "^5.8.0",
    "react-tag-input-component": "^2.0.2",
    "react-toastify": "^10.0.5",
    "sharp": "^0.33.2",
    "swiper": "^12.1.2",
    "uuid": "^14.0.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
